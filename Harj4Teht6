# Luokka noden kuvaamiseksi
class Noodi:
    def __init__(self, v):
        self.key = v
        self.left = None
        self.right = None

# Aliohjelmat eri järjestyksissä kutsumiseksi
def printSisajarjestys(root):
    if root:
        # Mennaan rekursiivisesti vasemmalle
        printSisajarjestys(root.left)
        # Poimitaan arvo
        print(root.key,end = " ")
        # Mennaan rekursiivisesti oikealle
        printSisajarjestys(root.right)

def printEsijarjestys(node):
    if node is None:
        return
    # Poimitaan arvo
    print(node.key, end = " ")
    # Mennaan rekursiivisesti vasemmalle
    printEsijarjestys(node.left)
    # Mennaan rekursiivisesti oikealle
    printEsijarjestys(node.right)

def printJalkijarjestys(node):
    if node is None:
        return
    # Mennaan rekursiivisesti vasemmalle
    printJalkijarjestys(node.left)
    # Mennaan rekursiivisesti oikealle
    printJalkijarjestys(node.right)
    # Poimitaan arvo
    print(node.key, end = " ")

# Aliohjelma kovakoodatun puun luomiseksi tehtävänannon mukaisesti
def teePuu():
    root = Noodi(25)
    root.left = Noodi(15)
    root.left.left = Noodi(12)
    root.left.right = Noodi(20)
    root.left.left.right = Noodi(13)
    root.left.right.left = Noodi(18)
    root.left.right.right = Noodi(21)
    root.right = Noodi(27)
    root.right.right = Noodi(30)
    root.right.right.left = Noodi(28)
    return root

if __name__ == "__main__":
    root = teePuu()

    print("Sisäjärjestys:", end=" ")
    printSisajarjestys(root)
    print()

    print("Esijärjestys:", end=" ")
    printEsijarjestys(root)
    print()
    
    print("Jälkijärjestys:", end=" ")
    printJalkijarjestys(root)
    print()
